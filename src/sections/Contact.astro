---
import FlipButton from "../components/FlipButton.astro";

export interface SocialLink {
    label: string;
    href: string;
}

export interface Props {
    /** Frase destacada de la columna izquierda (parte superior). */
    headline?: string;
    /** Título H2 de la columna derecha. */
    title?: string;
    companyName?: string;
    address?: string;
    /** Iniciales usadas como fallback cuando no hay avatar. */
    initials?: string;
    /** Imagen opcional del avatar/logo. */
    avatar?: string;
    socials?: SocialLink[];
    /** Texto previo al enlace de privacidad. */
    privacyText?: string;
    privacyLinkText?: string;
    privacyHref?: string;
    /** Endpoint del formulario (fallback sin JS; el envío real va a WhatsApp). */
    action?: string;
    submitLabel?: string;
    successMessage?: string;
    errorMessage?: string;
    pendingMessage?: string;
    /** Número de WhatsApp en formato internacional, sin espacios ni "+". */
    whatsappNumber?: string;
    /** Plantilla del mensaje. Admite {name}, {email}, {company} y {message}. */
    whatsappMessageTemplate?: string;
    class?: string;
}

// Enlaces sociales comentados temporalmente.
// const defaultSocials: SocialLink[] = [
//     { label: "LinkedIn", href: "https://www.linkedin.com" },
//     { label: "Instagram", href: "https://www.instagram.com" },
//     { label: "Facebook", href: "https://www.facebook.com" },
//     { label: "Twitter", href: "https://twitter.com" },
// ];

const {
    headline = "Planning a launch or a rebrand? Tell us about it.",
    title = "Contact us",
    companyName = "Pixel Studio Creative",
    address = "Barranquilla, Colombia",
    initials = "PS",
    avatar,
    // socials = defaultSocials,
    privacyText = "I have read and understood the",
    privacyLinkText = "privacy statement",
    privacyHref = "/privacy",
    action = "/api/contact",
    submitLabel = "Submit",
    successMessage = "WhatsApp opened in a new tab.",
    errorMessage = "We couldn't open WhatsApp. Please try again.",
    pendingMessage = "Preparing your message…",
    // TODO: reemplaza por el número real de WhatsApp.
    whatsappNumber = "15551234567",
    whatsappMessageTemplate = "New project enquiry\n\nName: {name}\nEmail: {email}\nCompany: {company}\n\nMessage:\n{message}",
    class: className,
}: Props = Astro.props;

const headingId = "contact-title";
---

<section
    data-contact
    class:list={[
        "relative w-full bg-[#0a0a0a] px-5 py-16 text-white sm:px-8 md:px-10 lg:px-16 lg:py-24",
        className,
    ]}
    aria-labelledby={headingId}
>
    <div class="grid w-full gap-16 md:grid-cols-2 md:gap-12 lg:gap-20">
        <!-- Columna izquierda: frase + información de contacto -->
        <div class="flex flex-col justify-between gap-16 md:min-h-[36rem]">
            <p class="max-w-md text-2xl leading-snug font-normal tracking-tight text-white sm:text-3xl">
                {headline}
            </p>

            <div class="flex flex-col gap-6">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-full border border-white/15 bg-white/[0.06] text-sm text-white/70">
                    {avatar ? (
                        <img
                            src={avatar}
                            alt={`${companyName} logo`}
                            width="48"
                            height="48"
                            loading="lazy"
                            decoding="async"
                            class="h-full w-full object-cover"
                        />
                    ) : (
                        <span aria-hidden="true">{initials}</span>
                    )}
                </div>

                <div>
                    <p class="text-base tracking-tight text-white">
                        {companyName}
                    </p>
                    <p class="mt-1 text-sm text-white/50">{address}</p>
                </div>

                {/* Redes sociales comentadas temporalmente.
                <ul
                    class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-white/50"
                >
                    {socials.map((social) => (
                        <li>
                            <a
                                href={social.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="transition-colors duration-300 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
                            >
                                {social.label}
                            </a>
                        </li>
                    ))}
                </ul>
                */}
            </div>
        </div>

        <!-- Columna derecha: título + formulario -->
        <div>
            <h2
                id={headingId}
                class="text-[clamp(2.75rem,8vw,6rem)] leading-[0.95] font-normal tracking-[-0.04em] text-white"
            >
                {title}
            </h2>

            <form
                data-contact-form
                method="POST"
                action={action}
                data-success-message={successMessage}
                data-error-message={errorMessage}
                data-pending-message={pendingMessage}
                data-whatsapp-number={whatsappNumber}
                data-whatsapp-template={whatsappMessageTemplate}
                class="mt-12 flex flex-col gap-10 lg:mt-16"
            >
                <!-- Nombre y apellido -->
                <div class="grid gap-10 sm:grid-cols-2 sm:gap-8">
                    <div>
                        <label for="contact-first-name" class="sr-only">
                            First name
                        </label>
                        <input
                            id="contact-first-name"
                            name="firstName"
                            type="text"
                            autocomplete="given-name"
                            placeholder="First name"
                            required
                            class="w-full border-0 border-b border-white/20 bg-transparent py-3 text-base text-white transition-colors duration-300 placeholder:text-white/40 hover:border-white/40 focus:border-white focus:outline-none"
                        />
                    </div>

                    <div>
                        <label for="contact-last-name" class="sr-only">
                            Last name
                        </label>
                        <input
                            id="contact-last-name"
                            name="lastName"
                            type="text"
                            autocomplete="family-name"
                            placeholder="Last name"
                            class="w-full border-0 border-b border-white/20 bg-transparent py-3 text-base text-white transition-colors duration-300 placeholder:text-white/40 hover:border-white/40 focus:border-white focus:outline-none"
                        />
                    </div>
                </div>

                <!-- Email -->
                <div>
                    <label for="contact-email" class="sr-only">
                        Email
                    </label>
                    <input
                        id="contact-email"
                        name="email"
                        type="email"
                        autocomplete="email"
                        placeholder="Email"
                        required
                        class="w-full border-0 border-b border-white/20 bg-transparent py-3 text-base text-white transition-colors duration-300 placeholder:text-white/40 hover:border-white/40 focus:border-white focus:outline-none"
                    />
                </div>

                <!-- Empresa -->
                <div>
                    <label for="contact-company" class="sr-only">
                        Company
                    </label>
                    <input
                        id="contact-company"
                        name="company"
                        type="text"
                        autocomplete="organization"
                        placeholder="Company"
                        class="w-full border-0 border-b border-white/20 bg-transparent py-3 text-base text-white transition-colors duration-300 placeholder:text-white/40 hover:border-white/40 focus:border-white focus:outline-none"
                    />
                </div>

                <!-- Mensaje: crece con el contenido mediante el script -->
                <div>
                    <label for="contact-message" class="sr-only">
                        Type your message
                    </label>
                    <textarea
                        id="contact-message"
                        name="message"
                        data-autogrow
                        rows="1"
                        placeholder="Type your message"
                        required
                        class="w-full resize-none overflow-hidden border-0 border-b border-white/20 bg-transparent py-3 text-base text-white transition-colors duration-300 placeholder:text-white/40 hover:border-white/40 focus:border-white focus:outline-none"
                    ></textarea>
                </div>

                <!-- Privacidad -->
                <div class="flex flex-col gap-2">
                    <label class="group/check flex cursor-pointer items-start gap-3 text-sm leading-relaxed text-white/60">
                        <input
                            type="checkbox"
                            name="privacy"
                            value="accepted"
                            required
                            class="peer sr-only"
                        />
                        <span
                            class="mt-0.5 grid h-4.5 w-4.5 shrink-0 place-items-center rounded-full border border-white/40 text-[#0a0a0a] transition-colors duration-300 peer-hover:border-white/70 peer-checked:border-white peer-checked:bg-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-4 peer-focus-visible:outline-white peer-checked:[&_svg]:opacity-100"
                            aria-hidden="true"
                        >
                            <svg
                                class="h-2.5 w-2.5 opacity-0 transition-opacity duration-200"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="3"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="M20 6 9 17l-5-5"></path>
                            </svg>
                        </span>
                        <span>
                            {privacyText}{" "}
                            <a
                                href={privacyHref}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-white underline decoration-white/40 underline-offset-4 transition-colors duration-300 hover:decoration-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
                            >
                                {privacyLinkText}
                            </a>
                        </span>
                    </label>
                </div>

                <!-- Botón existente del proyecto (no aplicar estilos propios) -->
                <div class="flex flex-wrap items-center gap-4">
                    <FlipButton text={submitLabel} type="submit" />
                </div>

                <p
                    data-contact-status
                    role="status"
                    aria-live="polite"
                    data-state="idle"
                    class="min-h-5 text-sm text-white/50 data-[state=error]:text-red-400 data-[state=success]:text-white"
                ></p>
            </form>
        </div>
    </div>
</section>

<script>
    let cleanup: (() => void) | null = null;

    const initContact = (): void => {
        const form = document.querySelector<HTMLFormElement>(
            "[data-contact-form]",
        );
        if (!form) return;

        cleanup?.();
        cleanup = null;

        const submit = form.querySelector<HTMLButtonElement>(
            'button[type="submit"]',
        );
        const status = form.querySelector<HTMLElement>("[data-contact-status]");
        const textareas = Array.from(
            form.querySelectorAll<HTMLTextAreaElement>("[data-autogrow]"),
        );

        const pendingMessage = form.dataset.pendingMessage ?? "Sending…";
        const successMessage =
            form.dataset.successMessage ?? "WhatsApp opened.";
        const errorMessage =
            form.dataset.errorMessage ?? "Something went wrong.";

        // Número y plantilla vienen de las props del componente.
        const whatsappNumber = (form.dataset.whatsappNumber ?? "").replace(
            /\D/g,
            "",
        );
        const messageTemplate = form.dataset.whatsappTemplate ?? "";

        let sending = false;

        /** Ajusta la altura del textarea para que crezca con el contenido. */
        const resize = (field: HTMLTextAreaElement): void => {
            field.style.height = "auto";
            field.style.height = `${field.scrollHeight}px`;
        };

        textareas.forEach(resize);

        const onInput = (event: Event): void => {
            const target = event.target;
            if (target instanceof HTMLTextAreaElement) resize(target);
        };

        const setStatus = (
            message: string,
            state: "pending" | "success" | "error",
        ): void => {
            if (!status) return;
            status.textContent = message;
            status.dataset.state = state;
        };

        const onSubmit = (event: SubmitEvent): void => {
            event.preventDefault();
            if (sending) return;

            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            if (!whatsappNumber) {
                setStatus(errorMessage, "error");
                return;
            }

            sending = true;
            form.setAttribute("aria-busy", "true");
            if (submit) submit.disabled = true;
            setStatus(pendingMessage, "pending");

            try {
                const data = new FormData(form);
                const field = (name: string): string =>
                    String(data.get(name) ?? "").trim();

                // Plantilla de WhatsApp con los valores del formulario.
                const values: Record<string, string> = {
                    name: [field("firstName"), field("lastName")]
                        .filter(Boolean)
                        .join(" "),
                    email: field("email"),
                    company: field("company"),
                    message: field("message"),
                };

                const text = messageTemplate.replace(
                    /\{(\w+)\}/g,
                    (_match, key: string) => values[key] ?? "",
                );

                // 👉 El envío se hace abriendo WhatsApp con el mensaje
                // prellenado. El número se configura con la prop
                // `whatsappNumber` y el texto con `whatsappMessageTemplate`.
                const url = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(text)}`;
                window.open(url, "_blank", "noopener,noreferrer");

                form.reset();
                textareas.forEach(resize);
                setStatus(successMessage, "success");
            } catch (error) {
                console.error(error);
                setStatus(errorMessage, "error");
            } finally {
                sending = false;
                form.removeAttribute("aria-busy");
                if (submit) submit.disabled = false;
            }
        };

        form.addEventListener("input", onInput);
        form.addEventListener("submit", onSubmit);

        cleanup = () => {
            form.removeEventListener("input", onInput);
            form.removeEventListener("submit", onSubmit);
            cleanup = null;
        };
    };

    initContact();

    // Compatibilidad con View Transitions de Astro.
    document.addEventListener("astro:page-load", initContact);
    document.addEventListener("astro:before-swap", () => cleanup?.());
    window.addEventListener("pagehide", () => cleanup?.());
</script>
