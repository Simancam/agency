---
export interface Tool {
    name: string;
    /** Ruta pública del logo, e.g. "/logos/figma_logo.svg". */
    logo: string;
    href?: string;
    /** Clases extra para ajustar el tamaño de un logo concreto. */
    logoClass?: string;
}

export interface Props {
    tools?: Tool[];
    title?: string;
    class?: string;
}

const defaultTools: Tool[] = [
    { name: "Google Ads", logo: "/logos/google_ads_logo.svg", href: "https://ads.google.com", logoClass: "h-10 md:h-12" },
    { name: "Meta", logo: "/logos/meta_logo.svg", href: "https://www.meta.com" },
    { name: "Adobe", logo: "/logos/adobe_logo.svg.png", href: "https://www.adobe.com" },
    { name: "CapCut", logo: "/logos/capcut_logo.svg", href: "https://www.capcut.com" },
    { name: "Figma", logo: "/logos/figma_logo.svg", href: "https://www.figma.com" },
    { name: "Claude", logo: "/logos/claude_logo.svg.png", href: "https://claude.ai" },
];

const {
    tools = defaultTools,
    title,
    class: className,
}: Props = Astro.props;

const headingId = "tools-logos-title";
---

<section
    data-tools-logos
    class:list={[
        "relative w-full bg-[#0a0a0a] px-5 py-16 text-white sm:px-8 md:px-10 lg:px-16 lg:py-20",
        className,
    ]}
    aria-labelledby={title ? headingId : undefined}
    aria-label={title ? undefined : "Tools and technologies"}
>
    {title && (
        <h2
            id={headingId}
            class="mb-12 text-center text-3xl font-normal tracking-tight text-white md:mb-16 md:text-4xl"
        >
            {title}
        </h2>
    )}

    <ul
        class="mx-auto grid max-w-5xl grid-cols-2 items-center gap-x-8 gap-y-12 sm:grid-cols-3 md:gap-x-16 md:gap-y-16 lg:gap-x-24 lg:gap-y-20"
    >
        {tools.map((tool) => {
            const Tag = tool.href ? "a" : "div";

            return (
                <li class="flex items-center justify-center">
                    <Tag
                        href={tool.href}
                        target={tool.href ? "_blank" : undefined}
                        rel={tool.href ? "noopener noreferrer" : undefined}
                        aria-label={tool.name}
                        class="group flex items-center justify-center rounded-sm focus-visible:outline-2 focus-visible:outline-offset-8 focus-visible:outline-white"
                    >
                        {/* Los logos se unifican a blanco con filtros en este tema
                            oscuro y recuperan su opacidad al hacer hover. */}
                        <span class="flex h-8 w-24 items-center justify-center md:h-10 md:w-28">
                            <img
                                src={tool.logo}
                                alt=""
                                loading="lazy"
                                decoding="async"
                                class:list={[
                                    "w-auto object-contain opacity-40 grayscale brightness-0 invert transition duration-300 ease-out group-hover:opacity-100",
                                    tool.logoClass ?? "max-h-full max-w-full",
                                ]}
                            />
                        </span>
                    </Tag>
                </li>
            );
        })}
    </ul>
</section>
