---
export type SocialIcon = "x" | "instagram" | "youtube" | "linkedin";

export interface SocialLink {
    label: string;
    href: string;
    icon: SocialIcon;
}

export interface FooterLink {
    label: string;
    href: string;
    badge?: string;
}

export interface FooterColumn {
    title: string;
    links: FooterLink[];
}

export interface Props {
    /** Nombre de marca. Placeholder: reemplázalo por el real. */
    brand?: string;
    brandTagline?: string;
    socials?: SocialLink[];
    columns?: FooterColumn[];
    legalLinks?: FooterLink[];
    /** Texto adicional junto al copyright, tras el nombre de marca. */
    copyrightNote?: string;
    class?: string;
}

/** Iconos sociales como SVG inline, resueltos por clave. */
const icons: Record<SocialIcon, string> = {
    x: '<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>',
    instagram:
        '<path d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.899 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.899-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678c-3.405 0-6.162 2.76-6.162 6.162 0 3.405 2.76 6.162 6.162 6.162 3.405 0 6.162-2.76 6.162-6.162 0-3.405-2.76-6.162-6.162-6.162zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405c0 .795-.646 1.44-1.44 1.44-.795 0-1.44-.646-1.44-1.44 0-.794.646-1.439 1.44-1.439.793-.001 1.44.645 1.44 1.439z"/>',
    youtube:
        '<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>',
    linkedin:
        '<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>',
};

const defaultSocials: SocialLink[] = [
    { label: "X (Twitter)", href: "https://x.com", icon: "x" },
    {
        label: "Instagram",
        href: "https://www.instagram.com",
        icon: "instagram",
    },
    { label: "YouTube", href: "https://www.youtube.com", icon: "youtube" },
    { label: "LinkedIn", href: "https://www.linkedin.com", icon: "linkedin" },
];

const defaultColumns: FooterColumn[] = [
    {
        title: "Product",
        links: [{ label: "Product updates", href: "/product-updates" }],
    },
    {
        title: "Resources",
        links: [
            { label: "Customer stories", href: "/customer-stories" },
            { label: "Product docs", href: "/docs" },
        ],
    },
    {
        title: "Company",
        links: [
            { label: "About", href: "/about" },
            { label: "Careers", href: "/careers", badge: "We're hiring" },
        ],
    },
];

const defaultLegalLinks: FooterLink[] = [
    { label: "Security", href: "/security" },
    { label: "Terms of service", href: "/terms" },
    { label: "Privacy policy", href: "/privacy" },
];

const {
    brand = "Refracta",
    brandTagline = "Your Brand is the modern and intuitive way to model & protect your business.",
    socials = defaultSocials,
    columns = defaultColumns,
    legalLinks = defaultLegalLinks,
    class: className,
}: Props = Astro.props;

const year = new Date().getFullYear();
const wordmark = brand.toUpperCase();

// Geometría del wordmark en SVG: el ancho se adapta a la longitud de la
// marca y `textLength` ajusta solo el espaciado, nunca la forma de las letras.
const wordmarkCharWidth = 70;
const wordmarkWidth = Math.max(1, wordmark.length) * wordmarkCharWidth;
const wordmarkHeight = 88;
const wordmarkBaseline = 96;
---

<footer
    class:list={[
        "relative mt-16 w-full overflow-hidden border-t border-white/15 bg-[#0a0a0a] text-white sm:mt-20 lg:mt-24",
        className,
    ]}
>
    <!-- Zona superior: marca + columnas de enlaces -->
    <div class="px-5 pt-16 sm:px-8 md:px-10 lg:px-16 lg:pt-24">
        <div class="grid gap-12 md:grid-cols-2 md:gap-10 lg:grid-cols-[minmax(0,1.6fr)_repeat(3,minmax(0,1fr))] lg:gap-8">
            <!-- Marca -->
            <div class="max-w-sm">
                <p class="text-xl leading-snug font-normal tracking-tight text-white sm:text-2xl">
                    {brandTagline}
                </p>

                <ul class="mt-8 flex flex-wrap items-center gap-3">
                    {socials.map((social) => (
                        <li>
                            <a
                                href={social.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={social.label}
                                class="grid h-10 w-10 place-items-center rounded-full border border-white/20 text-white/70 transition-colors duration-300 hover:border-white/60 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                            >
                                <svg
                                    class="h-4 w-4"
                                    viewBox="0 0 24 24"
                                    fill="currentColor"
                                    aria-hidden="true"
                                    set:html={icons[social.icon]}
                                />
                            </a>
                        </li>
                    ))}
                </ul>
            </div>

            <!-- Columnas de enlaces -->
            {columns.map((column) => (
                <nav aria-label={column.title}>
                    <h3 class="text-base font-medium tracking-tight text-white">
                        {column.title}
                    </h3>
                    <ul class="mt-4 flex flex-col gap-3">
                        {column.links.map((link) => (
                            <li class="flex flex-wrap items-center gap-2">
                                <a
                                    href={link.href}
                                    class="text-sm text-white/50 transition-colors duration-300 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
                                >
                                    {link.label}
                                </a>
                                {link.badge && (
                                    <span class="rounded-full border border-white/15 bg-white/[0.06] px-2 py-0.5 text-[0.65rem] tracking-wide text-white/60">
                                        {link.badge}
                                    </span>
                                )}
                            </li>
                        ))}
                    </ul>
                </nav>
            ))}
        </div>
    </div>

    <!-- Wordmark gigante, decorativo. En SVG para un contorno limpio y
         sin deformar las letras; el viewBox inferior recorta su base. -->
    <div
        class="pointer-events-none relative mt-16 overflow-hidden px-5 select-none sm:px-8 md:mt-20 md:px-10 lg:px-16"
        aria-hidden="true"
    >
        <svg
            class="block h-auto w-full overflow-hidden font-display [font-stretch:110%] [mask-image:linear-gradient(to_bottom,black_70%,transparent_100%)] [-webkit-mask-image:linear-gradient(to_bottom,black_70%,transparent_100%)]"
            viewBox={`0 0 ${wordmarkWidth} ${wordmarkHeight}`}
            preserveAspectRatio="xMinYMin meet"
            aria-hidden="true"
            focusable="false"
        >
            <text
                x="0"
                y={wordmarkBaseline}
                textLength={wordmarkWidth}
                lengthAdjust="spacing"
                font-size="100"
                font-weight="500"
                fill="none"
                stroke="rgba(255,255,255,0.35)"
                stroke-width="1"
                vector-effect="non-scaling-stroke"
            >
                {wordmark}
            </text>
        </svg>
    </div>

    <!-- Barra inferior -->
    <div class="border-t border-white/15">
        <div class="flex flex-col gap-4 px-5 py-6 text-sm text-white/50 sm:px-8 md:flex-row md:items-center md:justify-between md:px-10 lg:px-16">
            <p>
                © {year} {brand}{" "}
            </p>

            <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
                {legalLinks.map((link) => (
                    <li>
                        <a
                            href={link.href}
                            class="transition-colors duration-300 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
                        >
                            {link.label}
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </div>
</footer>
